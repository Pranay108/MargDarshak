# LLM Configuration for BIS-Saathi Frontend & Backend
# Gemini API Key
VITE_LLM_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here

# Mistral AI API Key (High volume / fallback)
VITE_MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Provider: 'gemini' | 'mistral' | 'openai'
VITE_LLM_PROVIDER=gemini

# Model Name
VITE_LLM_MODEL=gemini-3.8-flash
VITE_GEMINI_MODEL=gemini-3.8-flash
VITE_MISTRAL_MODEL=mistral-small-latest
